{
  "name": "icf-icd-mcp",
  "version": "1.6.1",
  "description": "MCP-Server für die deutsche ICF, die ICD-10-GM, das Begutachtungsinstrument nach § 15 SGB XI und die Versorgungsmedizinischen Grundsätze (VersMedV)",
  "private": true,
  "type": "module",
  "bin": {
    "icf-icd-mcp": "src/server.mjs"
  },
  "files": [
    "src",
    "data/icf_flat.json",
    "data/qualifiers.json",
    "data/icd10gm.json",
    "data/icd10gm_alpha.json",
    "data/bi.json",
    "data/versmedv.json",
    "data/fallprofil-1.schema.json",
    "data/fallprofil-1.beispiel.json"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "build:data": "scripts/build_data.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/politpatrick/icf-icd-mcp.git"
  },
  "keywords": ["icf", "icd-10-gm", "mcp", "model-context-protocol", "claude", "teilhabe", "sgb-ix", "sgb-xi", "pflegebegutachtung", "versmedv", "gdb", "schwerbehinderung"]
}
